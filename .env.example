# Set this in Vercel > Project Settings > Environment Variables.
# Use the exact primary HTTPS domain, without a path or trailing slash.
# Optional; the primary domain is already set in site.config.mjs.
SITE_URL=

# Optional: the public Web3Forms access key already exists in site.config.mjs.
WEB3FORMS_ACCESS_KEY=

# Optional: value from a Google Search Console URL-prefix verification tag.
GOOGLE_SITE_VERIFICATION=
