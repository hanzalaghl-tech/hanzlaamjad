{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/gohighlevel-expert",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/automation-expert",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/funnel-expert",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/gohighlevel-saas-mode-setup",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/gohighlevel-snapshots",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/gohighlevel-integrations",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/gohighlevel-expert-pakistan",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/#privacy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/hanzla-amjad-resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Hanzla-Amjad-CV.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    }
  ]
}
